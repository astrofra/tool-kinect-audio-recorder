{
  "version": 3,
  "configurePresets": [
    {
      "name": "windows",
      "displayName": "Windows x64, Visual Studio 2022",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/windows",
      "cacheVariables": { "RECORDER_BUILD_GUI": "ON", "BUILD_TESTING": "ON" }
    },
    {
      "name": "windows-release",
      "displayName": "Windows x64 distributable, static C/C++ runtime",
      "inherits": "windows",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>",
        "USE_MSVC_RUNTIME_LIBRARY_DLL": "OFF",
        "BUILD_SHARED_LIBS": "OFF",
        "CMAKE_INSTALL_BINDIR": "."
      }
    },
    {
      "name": "portable",
      "displayName": "Portable CLI and simulation",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/portable",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "RECORDER_BUILD_GUI": "OFF" }
    }
  ],
  "buildPresets": [
    { "name": "windows", "configurePreset": "windows", "configuration": "Release" },
    { "name": "windows-release", "configurePreset": "windows-release", "configuration": "Release" },
    { "name": "portable", "configurePreset": "portable" }
  ],
  "testPresets": [
    { "name": "windows", "configurePreset": "windows", "configuration": "Release", "output": { "outputOnFailure": true } },
    { "name": "windows-release", "configurePreset": "windows-release", "configuration": "Release", "output": { "outputOnFailure": true } },
    { "name": "portable", "configurePreset": "portable", "output": { "outputOnFailure": true } }
  ]
}
